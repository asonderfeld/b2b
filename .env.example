# PostgreSQL-Verbindung (z.B. Vercel Postgres, Neon, Supabase)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth
# Erzeugen z.B. mit: openssl rand -base64 32
NEXTAUTH_SECRET="bitte-durch-zufaelligen-string-ersetzen"
NEXTAUTH_URL="http://localhost:3000"

# E-Mail-Versand (Resend, siehe https://resend.com)
# Ohne gesetzten Key wird jede Mail nur in die Server-Logs geschrieben statt
# tatsächlich verschickt - praktisch für die lokale Entwicklung.
RESEND_API_KEY=""
# Absenderadresse; die Domain muss bei Resend verifiziert sein (SPF/DKIM).
MAIL_FROM="mk | hotels Firmenraten <vertraege@mkhotels.de>"
# Optional: kommagetrennte Liste interner Empfänger für Benachrichtigungen
# ("neue Anfrage eingegangen", "Vertrag bereit zur Finalisierung"). Wenn
# leer, werden automatisch alle Nutzer mit Rolle ADMIN/SALES benachrichtigt.
SALES_NOTIFICATION_EMAIL=""
